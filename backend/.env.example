# ========== APPLICATION SETTINGS ==========
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ========== DATABASE SETTINGS ==========
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinarlytics

# ========== SECURITY SETTINGS ==========
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256

# JWT Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Requirements
PASSWORD_MIN_LENGTH=8

# Session Configuration
SESSION_EXPIRE_MINUTES=480
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT_MINUTES=15

# ========== CORS SETTINGS ==========
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# ========== EMAIL SETTINGS ==========
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@dinarlytics.com

# ========== FILE UPLOAD SETTINGS ==========
MAX_UPLOAD_SIZE_MB=100
UPLOAD_FOLDER=uploads

# ========== EXTERNAL SERVICES ==========
# Sentry Error Tracking (optional)
SENTRY_DSN=

# ========== AI SERVICE SETTINGS ==========
AI_MODEL_PATH=models/
AI_FEATURE_STORE_ENABLED=True
AI_DRIFT_DETECTION_ENABLED=True
