# Dinarlytics Environment Configuration

# ============ PostgreSQL ============
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=dinarlytics

# ============ FastAPI Backend ============
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# ============ React Frontend ============
VITE_API_URL=http://localhost:8000

# ============ AI Model ============
MODEL_PATH=/path/to/pretrained/model.pt
MODEL_VERSION=1.0.0

# ============ Security (Production) ============
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============ Email Notifications (Optional) ============
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=admin@dinarlytics.com

# ============ Logging ============
LOG_LEVEL=INFO
LOG_FILE=/var/log/dinarlytics/app.log

# ============ Redis Cache (Optional, Future) ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ Sentry Error Tracking (Optional) ============
SENTRY_DSN=

# ============ Feature Flags ============
ENABLE_AI_PREDICTIONS=True
ENABLE_DRIFT_MONITORING=True
ENABLE_AUDIT_LOGGING=True
